# Canonical origin used for canonical URLs, hreflang, sitemap and JSON-LD.
# Defaults to https://arabicmarket.asia if unset (then VERCEL_PROJECT_PRODUCTION_URL on Vercel).
NEXT_PUBLIC_SITE_URL=https://arabicmarket.asia

# Where the audit form posts leads (Zapier / Make / n8n / CRM webhook).
# Without it the form returns an error in production (so leads are never silently lost).
AUDIT_WEBHOOK_URL=

# Optional contact channels. Nothing is shown until you set them (no placeholder contact details are published).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
